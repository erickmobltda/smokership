# Firebase web app (project erickmob-apps). Values: firebase apps:sdkconfig WEB <appId> --project erickmob-apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=erickmob-apps.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=erickmob-apps
VITE_FIREBASE_APP_ID=
# Optional: where cigar images are served (default: erickmob-api behind Cloudflare)
VITE_IMAGES_BASE=https://api.erickmob.dev/smokership/images
